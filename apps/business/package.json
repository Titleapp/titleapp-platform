{
  "name": "titleapp-business-admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
    "dev:nursing": "vite --mode nursing --port 5175",
    "build": "vite build",
    "build:nursing": "vite build --mode nursing",
    "lint": "eslint .",
    "knip": "knip",
    "preview": "vite preview --port 4174",
    "cap:sync": "npm run build && npx cap sync",
    "cap:ios": "npm run build && npx cap sync ios && npx cap open ios",
    "cap:android": "npm run build && npx cap sync android && npx cap open android",
    "cap:nursing:sync": "npm run build:nursing && npx cap sync",
    "cap:nursing:ios": "npm run build:nursing && npx cap sync ios && npx cap open ios",
    "cap:nursing:android": "npm run build:nursing && npx cap sync android && npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "canvas-confetti": "^1.9.4",
    "firebase": "^12.8.0",
    "leaflet": "^1.9.4",
    "leaflet-imageoverlay-rotated": "^0.2.1",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.7.0",
    "rehype-raw": "^7.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "knip": "^6.25.0",
    "typescript": "^7.0.2",
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "knip": {
    "entry": [
      "src/main.jsx"
    ],
    "project": [
      "src/**/*.{js,jsx}"
    ],
    "ignore": [
      "src/components/canvas/**",
      "src/config/canvasTypes.js"
    ]
  }
}
