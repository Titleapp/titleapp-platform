{
  "id": "cre_deal_screen_v0",
  "version": "v0",
  "domain": "commercial-real-estate",
  "required_inputs": [
    "rent_roll",
    "t12",
    "offering_memo"
  ],
  "hard_stops": [
    {
      "id": "missing_core_docs",
      "logic": "any required_inputs missing",
      "eval": { "type": "required_inputs_check" }
    },
    {
      "id": "ltv_exceeds_max",
      "logic": "if tenant.max_ltv provided AND deal.ltv > tenant.max_ltv",
      "eval": { "field": "metrics.ltv", "operator": ">", "threshold": "tenant.max_ltv", "conditional": true }
    },
    {
      "id": "dscr_below_min",
      "logic": "if tenant.min_dscr provided AND deal.dscr < tenant.min_dscr",
      "eval": { "field": "metrics.dscr", "operator": "<", "threshold": "tenant.min_dscr", "conditional": true }
    }
  ],
  "soft_flags": [
    {
      "id": "single_tenant_risk",
      "logic": "tenant_count == 1",
      "eval": { "field": "metrics.tenant_count", "operator": "==", "threshold": 1 }
    },
    {
      "id": "short_walt",
      "logic": "walt_years < 2",
      "eval": { "field": "metrics.walt_years", "operator": "<", "threshold": 2 }
    }
  ],
  "outputs": [
    "da-ic-memo",
    "da-risk-summary",
    "da-assumptions",
    "da-evidence-table"
  ],
  "chat_rules": [
    {
      "id": "cre-no-investment-advice",
      "pattern": "(guaranteed return|will appreciate|certain to|safe investment|can't lose)",
      "flags": "i",
      "message": "Do not guarantee returns or characterize any deal as safe or certain. Present the underwriting data and risk factors; let the investor draw their own conclusions."
    },
    {
      "id": "cre-evidence-first",
      "pattern": "(looks good|seems strong|should perform|likely to|probably will)",
      "flags": "i",
      "message": "Replace subjective characterizations with specific data points: cap rate, NOI, occupancy, DSCR, or comparable sales. State the metric and its source, then let the user evaluate."
    },
    {
      "id": "cre-no-missing-docs",
      "pattern": "(assume|assuming|estimate|roughly|approximately).{0,40}(rent roll|t-12|t12|offering memo|financials)",
      "flags": "i",
      "message": "Do not estimate or assume missing underwriting documents. State which documents are absent and what analysis is blocked until they are provided."
    }
  ]
}
